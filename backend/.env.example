# Copy to backend/.env; keep the real key out of Git and frontend JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Đăng nhập bằng Google (OAuth). Lấy ở Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Để trống thì tự tính; nếu đặt thì phải trùng "Authorized redirect URIs" đã khai, vd:
# GOOGLE_REDIRECT_URI=http://localhost:8080/backend/api/auth/google-callback.php
